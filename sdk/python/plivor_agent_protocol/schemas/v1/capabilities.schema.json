{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://protocol.plivor.dev/v1/capabilities.schema.json",
  "title": "Plivor Agent Protocol capability negotiation",
  "$defs": {
    "capabilityId": {
      "type": "string",
      "pattern": "^[a-z][a-zA-Z0-9]*(?:\\.[a-z][a-zA-Z0-9]*)*$"
    },
    "capabilityList": {
      "type": "array",
      "items": { "$ref": "#/$defs/capabilityId" },
      "uniqueItems": true
    },
    "initializeParams": {
      "type": "object",
      "required": ["protocolVersion", "clientName", "clientVersion", "capabilities"],
      "properties": {
        "protocolVersion": { "$ref": "common.schema.json#/$defs/protocolVersion" },
        "clientName": { "type": "string", "minLength": 1 },
        "clientVersion": { "type": "string", "minLength": 1 },
        "capabilities": { "$ref": "#/$defs/capabilityList" }
      },
      "additionalProperties": false
    },
    "initializeResult": {
      "type": "object",
      "required": ["protocolVersion", "agentVersion", "supportedCapabilities"],
      "properties": {
        "protocolVersion": { "$ref": "common.schema.json#/$defs/protocolVersion" },
        "agentVersion": { "type": "string", "minLength": 1 },
        "supportedCapabilities": { "$ref": "#/$defs/capabilityList" }
      },
      "additionalProperties": false
    }
  }
}
